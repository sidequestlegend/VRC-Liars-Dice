<Project Sdk="Microsoft.NET.Sdk">
  <!-- Golden vectors: the upstream scripts, unchanged, compiled against Stubs.cs. Run with: dotnet run -c Release (writes ../vectors.json) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0414;CS0169;CS0649;CS0108;CS0114;CS0219;CS0162</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Stubs.cs;Program.cs" />
    <Compile Include="..\..\..\..\Assets\LiarsDice\UdonScripts\*.cs" />
  </ItemGroup>
</Project>
